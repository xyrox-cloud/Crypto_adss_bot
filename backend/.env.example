# Server
PORT=3001
NODE_ENV=development

# Admin Panel
ADMIN_PASSWORD=your_admin_password_here
ADMIN_JWT_SECRET=your_super_secret_jwt_key_here

# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Database
DB_PATH=./data/adshare.db

# Per-ad reward in USDT (user gets 60%, platform keeps 40%)
AD_REWARD_USDT=0.01

# Rate limits
MAX_ADS_PER_DAY=20
MAX_ADS_PER_HOUR=5

# Minimum withdrawal amount in USDT
MIN_WITHDRAWAL=2.00

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
